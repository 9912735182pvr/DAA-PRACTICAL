      "source": [
        "fact=1\n",
        "def factorial(a):\n",
        "  global fact\n",
        "  if a>1:\n",
        "    fact = fact*a\n",
        "    factorial(a-1)\n",
        "\n",
        "  else:\n",
        "    return\n",
        "num =int(input(\"enter a number for factorial\"))\n",
        "factorial(num)\n",
        "print(\"factorial of\",num,\"is\",fact)"
      ],
