      "source": [
        "#insertion sort\n",
        "a = list(map(int, input(\"Enter numbers: \").split()))\n",
        "\n",
        "for i in range(1, len(a)):\n",
        "    key = a[i]\n",
        "    j = i - 1\n",
        "\n",
        "    while j >= 0 and a[j] > key:\n",
        "        a[j + 1] = a[j]\n",
        "        j -= 1\n",
        "\n",
        "    a[j + 1] = key\n",
        "\n",
        "print(\"Sorted array:\", a)"
      ],
      "metadata": {
